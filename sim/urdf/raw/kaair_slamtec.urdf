  <!-- Insert at the end of xarm_device_macro.xacro -->
  <link name="hand_base_link">
    <!-- visual -->
    <visual>
      <geometry>
        <mesh filename="package://kaair_description/meshes/tool/visual/hand_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="gray"/>
    </visual>
    <!-- collision -->
    <collision>
      <geometry>
        <mesh filename="package://kaair_description/meshes/tool/visual/hand_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
  </link>
  <link name="tooltip_collision_link">
