  <link name="tool_tcp_link"/>
  <joint name="hand_to_gripper_fix_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0135"/>
    <parent link="hand_base_link"/>
    <child link="gripper_body_link"/>
  </joint>
  <joint name="tooltip_dummpy_fix_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    <parent link="hand_base_link"/>
    <child link="tooltip_collision_link"/>
  </joint>
  <joint name="hand_to_vision_frame_fix_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
    <parent link="hand_base_link"/>
    <child link="vision_frame_link"/>
  </joint>
  <joint name="virtual_gripper_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="hand_base_link"/>
    <child link="virtual_gripper_link"/>
    <axis xyz="0 1 0"/>
    <!-- 0.01 m/s 이면 전개 0.1 m 에 ~10 s → GripperAction stall_timeout 과 맞물려 실패하기 쉬움 -->
    <limit effort="50" lower="0" upper="0.1" velocity="0.05"/>
  </joint>
  <joint name="gripper_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0 0.0 0.191"/>
    <parent link="gripper_body_link"/>
    <child link="tool_tcp_link"/>
  </joint>
  <joint name="right_finger_tip_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.0 0.0035 0.15325"/>
    <parent link="gripper_body_link"/>
    <child link="right_finger_tip"/>
    <axis xyz="0.0 1.0 0.0"/>
    <limit effort="50" lower="0" upper="0.05" velocity="0.005"/>
    <mimic joint="virtual_gripper_joint" multiplier="0.5" offset="0"/>
  </joint>
  <joint name="left_finger_tip_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0.0 -0.0035 0.15325"/>
    <parent link="gripper_body_link"/>
    <child link="left_finger_tip"/>
    <axis xyz="0.0 -1.0 0.0"/>
    <limit effort="50" lower="0" upper="0.05" velocity="0.005"/>
    <mimic joint="virtual_gripper_joint" multiplier="0.5" offset="0"/>
  </joint>
  <joint name="arm_to_tool_fix_joint" type="fixed">
    <origin rpy="0 0 3.1415926535897931" xyz="0.0 0.0 0.0"/>
    <parent link="link_eef"/>
    <child link="hand_base_link"/>
  </joint>
  <material name="aluminum">
    <color rgba="0.5 0.5 0.5 1"/>
  </material>
  <material name="plastic">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="camera_joint" type="fixed">
    <origin rpy="0 -1.5707963267948966 -3.1415926535897931" xyz="0.04428 0 0.02185"/>
    <parent link="vision_frame_link"/>
    <child link="camera_bottom_screw_frame"/>
  </joint>
  <link name="camera_bottom_screw_frame"/>
  <joint name="camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.01085 0.009 0.021"/>
    <parent link="camera_bottom_screw_frame"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0038 -0.009 0"/>
      <geometry>
        <mesh filename="package://realsense2_description/meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0078 -0.009 0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- camera depth joints and links -->
  <joint name="camera_depth_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>
  <!-- camera left IR joints and links -->
  <joint name="camera_infra1_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0 0"/>
